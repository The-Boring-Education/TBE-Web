# ===================================================================
# TBE Platform - Environment Variables Template
# ===================================================================

NODE_ENV=development

# Database (only needed if platform connects directly)
MONGODB_URI=mongodb://localhost:27017/tbe-platform

# Centralized auth - only need the API URL
NEXT_PUBLIC_API_URL=http://localhost:3004/api/v1

# App URLs
NEXT_PUBLIC_PLATFORM_URL=http://localhost:3000
NEXT_PUBLIC_ONBOARDING_APP_URL=http://localhost:3003
PREPYATRA_APP_URL=http://localhost:3001
# Optional overrides for “Continue” after payment on /payment/status (defaults match dev ports + production domains)
NEXT_PUBLIC_DSAYATRA_APP_URL=http://localhost:3005
NEXT_PUBLIC_PREPYATRA_APP_URL=http://localhost:3001
NEXT_PUBLIC_ONCAMPUS_APP_URL=http://localhost:3007
QUIZ_APP_URL=http://localhost:3002

# External APIs
YOUTUBE_API_KEY=your-youtube-api-key

# Payment Gateway
CASHFREE_BASE_URL=https://sandbox.cashfree.com/pg
CASHFREE_CLIENT_ID=your-cashfree-client-id
CASHFREE_SECRET_KEY=your-cashfree-secret-key

# Monitoring
NEXT_PUBLIC_GOOGLE_ANALYTICS=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_GTM_ID=

# Admin
ADMIN_SECRET=your-admin-secret
ADMIN_BASE_URL=http://localhost:8080

# Email
EMAIL_SERVICE_URL=https://chitthi.up.railway.app
EMAIL_API_KEY=your-email-api-key
FROM_EMAIL=noreply@theboringeducation.com

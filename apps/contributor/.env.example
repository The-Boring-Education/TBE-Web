# Centralized API app - used by @tbe/auth and contributor API calls
NEXT_PUBLIC_API_URL=http://localhost:3004/api/v1

# Optional override for the OAuth code exchange in /auth/callback (falls back to NEXT_PUBLIC_API_URL)
NEXT_PUBLIC_AUTH_API_URL=

# Used by next-sitemap on postbuild (defaults to https://contributors.theboringeducation.com)
SITE_URL=

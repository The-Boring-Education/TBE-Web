{
    "buildCommand": "cd ../.. && pnpm run build:prep-yatra",
    "outputDirectory": ".next",
    "framework": "nextjs",
    "installCommand": "cd ../.. && corepack enable && corepack prepare pnpm@9.15.9 --activate && pnpm install --no-frozen-lockfile",
    "devCommand": "cd ../.. && pnpm run dev:prep-yatra",
    "regions": [
        "iad1"
    ],
    "functions": {
        "src/pages/api/**/*.ts": {
            "maxDuration": 10
        }
    }
}
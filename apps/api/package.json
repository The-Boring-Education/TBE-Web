{
  "name": "@tbe/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3004",
    "build": "next build",
    "start": "next start -p 3000",
    "start:cloud-run": "node server.js",
    "lint": "next lint",
    "docker:build": "docker build -t tbe-api .",
    "docker:run": "docker run -p 3000:3000 tbe-api",
    "deploy:staging": "gcloud run deploy tbe-api-staging --source . --region us-central1",
    "deploy:production": "gcloud run deploy tbe-api --source . --region us-central1"
  },
  "dependencies": {
    "@sentry/nextjs": "^9.38.0",
    "@tbe/auth": "workspace:*",
    "axios": "^1.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "markdown-it": "^14.1.0",
    "mongoose": "^7.4.1",
    "next": "^13.2.4",
    "next-auth": "^4.24.7",
    "openai": "^4.85.2",
    "raw-body": "^3.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@tbe/eslint-config": "workspace:*",
    "@tbe/typescript-config": "workspace:*",
    "@types/cors": "^2.8.19",
    "@types/markdown-it": "^14.0.1",
    "@types/node": "18",
    "@types/raw-body": "^2.1.4",
    "@types/react": "^18.3.24",
    "@types/uuid": "^9.0.1",
    "eslint": "^8.36.0",
    "eslint-config-next": "^13.2.4",
    "typescript": "5.9.2"
  }
}
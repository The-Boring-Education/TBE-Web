MONGODB_URI=
# High-entropy secret for x-admin-secret protected routes (content export, aptitude
# upload, DSA freemium bypass). Must be at least 16 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_SECRET=
# Comma-separated emails allowed to bootstrap the FIRST admin via
# POST /api/v1/admin/admins/bootstrap. Unset this once the first admin exists —
# after that, admins are managed through the admin panel or the admin:add script.
ADMIN_BOOTSTRAP_EMAILS=
NEXTAUTH_SECRET=

# Centralized auth (also uses NEXTAUTH_SECRET if AUTH_JWT_SECRET not set)
AUTH_JWT_SECRET=
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=

# The public URL of this API app (used for Google OAuth callback)
# e.g. https://api.theboringeducation.com or http://localhost:3004
NEXT_PUBLIC_API_URL=http://localhost:3004

# Platform app origin (must be absolute — used for Cashfree order_meta.return_url).
# e.g. http://localhost:3000 or https://platform.theboringeducation.com
NEXT_PUBLIC_PLATFORM_URL=http://localhost:3000

# Optional: comma-separated origins allowed to use centralized auth
# localhost and *.vercel.app and *.theboringeducation.com are allowed by default
ALLOWED_AUTH_ORIGINS=

AGENTS_API_BASE=
# Payment Gateway (consumed by paymentConfig module)
# Sandbox: https://sandbox.cashfree.com or https://sandbox.cashfree.com/pg (PG API uses /pg/orders)
CASHFREE_BASE_URL=
CASHFREE_SECRET_KEY=
CASHFREE_CLIENT_ID=

EMAIL_SERVICE_URL=
EMAIL_API_KEY=
FROM_EMAIL=
NEXT_PUBLIC_ANALYTICS_ID=

# GA4 Data API (server-side growth analytics for admin dashboards)
GA4_PROPERTY_ID=
# JSON string of Google service account credentials with analytics.readonly scope
GA4_SERVICE_ACCOUNT_JSON=

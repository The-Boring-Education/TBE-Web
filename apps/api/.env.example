MONGODB_URI=
ADMIN_SECRET=
NEXTAUTH_SECRET=

# Centralized auth (also uses NEXTAUTH_SECRET if AUTH_JWT_SECRET not set)
AUTH_JWT_SECRET=
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=

# The public URL of this API app (used for Google OAuth callback)
# e.g. https://api.theboringeducation.com or http://localhost:3004
NEXT_PUBLIC_API_URL=http://localhost:3004

# Platform app origin (must be absolute — used for Cashfree order_meta.return_url).
# e.g. http://localhost:3000 or https://platform.theboringeducation.com
NEXT_PUBLIC_PLATFORM_URL=http://localhost:3000

# Optional: comma-separated extra origins allowed to make API requests (CORS).
# localhost, *.theboringeducation.com, and *.vercel.app are always allowed.
# Example: https://my-custom-domain.com,https://partner-site.com
ALLOWED_ORIGINS=

# Optional: comma-separated origins allowed to use centralized auth
# localhost and *.vercel.app and *.theboringeducation.com are allowed by default
ALLOWED_AUTH_ORIGINS=

AGENTS_API_BASE=
# Payment Gateway (consumed by paymentConfig module)
# Sandbox: https://sandbox.cashfree.com or https://sandbox.cashfree.com/pg (PG API uses /pg/orders)
CASHFREE_BASE_URL=
CASHFREE_SECRET_KEY=
CASHFREE_CLIENT_ID=

EMAIL_SERVICE_URL=
EMAIL_API_KEY=
FROM_EMAIL=
NEXT_PUBLIC_ANALYTICS_ID=

## 2. Onboarding API

Create an onboarding endpoint:

```javascript
// controllers/userController.js
const User = require('../models/User');

exports.checkUsername = async (req, res) => {
  try {
    const { username } = req.params;
    const user = await User.findOne({ userName: username });
    res.json({ exists: !!user });
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
};

exports.completeOnboarding = async (req, res) => {
  try {
    const { userId } = req;
    const { userName, profession, purpose, contactNo } = req.body;
    
    // Check if username exists
    const existingUser = await User.findOne({ userName });
    if (existingUser && existingUser._id.toString() !== userId) {
      return res.status(400).json({ error: 'Username already taken' });
    }
    
    // Update user
    const updatedUser = await User.findByIdAndUpdate(
      userId,
      {
        userName,
        profession,
        purpose,
        contactNo,
        isOnboarded: true
      },
      { new: true }
    );
    
    res.json(updatedUser);
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
};
```

## 3. Onboarding UI (React Example)

Here's a comprehensive onboarding component using React:

```jsx
// components/Onboarding.jsx
import React, { useState, useEffect } from 'react';
import { useRouter } from 'next/router';
import axios from 'axios';
import PhoneInput from 'react-phone-input-2';
import 'react-phone-input-2/lib/style.css';

const Onboarding = () => {
  const router = useRouter();
  const { redirectTo } = router.query;
  
  const [step, setStep] = useState(1);
  const [username, setUsername] = useState('');
  const [usernameError, setUsernameError] = useState('');
  const [profession, setProfession] = useState('');
  const [purpose, setPurpose] = useState([]);
  const [phone, setPhone] = useState('');
  const [isCheckingUsername, setIsCheckingUsername] = useState(false);
  const [isSubmitting, setIsSubmitting] = useState(false);
  
  // Throttle username check
  useEffect(() => {
    if (username.length < 3) return;
    
    const timer = setTimeout(async () => {
      setIsCheckingUsername(true);
      try {
        const res = await axios.get(`/api/user/check-username/${username}`);
        if (res.data.exists) {
          setUsernameError('Username already taken');
        } else {
          setUsernameError('');
        }
      } catch (error) {
        console.error(error);
      }
      setIsCheckingUsername(false);
    }, 500);
    
    return () => clearTimeout(timer);
  }, [username]);
  
  const handlePurposeChange = (value) => {
    if (purpose.includes(value)) {
      setPurpose(purpose.filter(item => item !== value));
    } else {
      setPurpose([...purpose, value]);
    }
  };
  
  const handleSubmit = async (e) => {
    e.preventDefault();
    setIsSubmitting(true);
    
    try {
      await axios.post('/api/user/onboard', {
        userName: username,
        profession,
        purpose,
        contactNo: phone
      });
      
      // Redirect to the original destination or home
      router.push(redirectTo || '/');
    } catch (error) {
      console.error('Onboarding failed:', error);
      setIsSubmitting(false);
    }
  };
  
  const nextStep = () => {
    if (step === 1 && (!username || usernameError)) return;
    if (step === 2 && !profession) return;
    if (step === 3 && purpose.length === 0) return;
    setStep(step + 1);
  };
  
  const prevStep = () => {
    setStep(step - 1);
  };
  
  return (
    <div className="max-w-md mx-auto p-6 bg-white rounded-lg shadow-md">
      {/* Progress Bar */}
      <div className="mb-8">
        <div className="flex justify-between mb-2">
          {[1, 2, 3, 4].map((i) => (
            <div 
              key={i}
              className={`w-8 h-8 rounded-full flex items-center justify-center 
                ${i < step ? 'bg-green-500 text-white' : 
                  i === step ? 'bg-blue-500 text-white' : 'bg-gray-200'}`}
            >
              {i}
            </div>
          ))}
        </div>
        <div className="w-full bg-gray-200 h-2 rounded-full">
          <div 
            className="bg-blue-500 h-2 rounded-full" 
            style={{ width: `${(step / 4) * 100}%` }}
          ></div>
        </div>
      </div>
      
      <form onSubmit={handleSubmit}>
        {/* Step 1: Username */}
        {step === 1 && (
          <div>
            <h2 className="text-xl font-semibold mb-4">Choose Your Username</h2>
            <div className="mb-4">
              <input
                type="text"
                value={username}
                onChange={(e) => setUsername(e.target.value)}
                className="w-full p-2 border rounded"
                placeholder="Enter username"
                required
              />
              {isCheckingUsername && <p className="text-sm text-gray-500">Checking availability...</p>}
              {usernameError && <p className="text-sm text-red-500">{usernameError}</p>}
            </div>
          </div>
        )}
        
        {/* Step 2: Profession */}
        {step === 2 && (
          <div>
            <h2 className="text-xl font-semibold mb-4">What do you do?</h2>
            <div className="space-y-2">
              {['Student', 'Working Professional'].map((option) => (
                <label key={option} className="flex items-center space-x-2">
                  <input
                    type="radio"
                    checked={profession === option}
                    onChange={() => setProfession(option)}
                    className="h-4 w-4"
                  />
                  <span>{option}</span>
                </label>
              ))}
            </div>
          </div>
        )}
        
        {/* Step 3: Purpose */}
        {step === 3 && (
          <div>
            <h2 className="text-xl font-semibold mb-4">How would you use the platform?</h2>
            <div className="space-y-2">
              {['Learning Tech', 'Building Projects', 'Interview Prep', 'Job Search'].map((option) => (
                <label key={option} className="flex items-center space-x-2">
                  <input
                    type="checkbox"
                    checked={purpose.includes(option)}
                    onChange={() => handlePurposeChange(option)}
                    className="h-4 w-4"
                  />
                  <span>{option}</span>
                </label>
              ))}
            </div>
          </div>
        )}
        
        {/* Step 4: Contact */}
        {step === 4 && (
          <div>
            <h2 className="text-xl font-semibold mb-4">Your Contact Number</h2>
            <div className="mb-4">
              <PhoneInput
                country={'us'}
                value={phone}
                onChange={setPhone}
                inputProps={{
                  required: true,
                }}
              />
            </div>
          </div>
        )}
        
        {/* Navigation Buttons */}
        <div className="flex justify-between mt-8">
          {step > 1 ? (
            <button
              type="button"
              onClick={prevStep}
              className="px-4 py-2 bg-gray-200 rounded hover:bg-gray-300"
            >
              Back
            </button>
          ) : (
            <div></div>
          )}
          
          {step < 4 ? (
            <button
              type="button"
              onClick={nextStep}
              className="px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600"
            >
              Next
            </button>
          ) : (
            <button
              type="submit"
              disabled={isSubmitting}
              className="px-4 py-2 bg-green-500 text-white rounded hover:bg-green-600 disabled:bg-green-300"
            >
              {isSubmitting ? 'Submitting...' : 'Complete Onboarding'}
            </button>
          )}
        </div>
      </form>
    </div>
  );
};

export default Onboarding;
```


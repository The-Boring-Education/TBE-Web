{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "env": [
        "GOOGLE_AUTH_CLIENT_ID",
        "GOOGLE_AUTH_CLIENT_SECRET",
        "MONGODB_URI",
        "API_URL",
        "AUTH_JWT_SECRET",
        "ADMIN_SECRET",
        "NEXTAUTH_SECRET",
        "NEXTAUTH_URL",
        "ALLOWED_AUTH_ORIGINS",
        "NODE_ENV",
        "OPENAI_API_KEY",
        "YOUTUBE_API_KEY",
        "ADMIN_BASE_URL",
        "CASHFREE_BASE_URL",
        "CASHFREE_SECRET_KEY",
        "CASHFREE_CLIENT_ID",
        "NEXT_PUBLIC_CASHFREE_MODE",
        "PREPYATRA_APP_URL",
        "QUIZ_APP_URL",
        "EMAIL_API_KEY",
        "FROM_EMAIL",
        "EMAIL_SERVICE_URL",
        "SENTRY_AUTH_TOKEN",
        "ONBOARDING_APP_URL",
        "QUIZZES_APP_URL",
        "NEXT_PUBLIC_UNSKILLED_API_URL",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_ONBOARDING_URL",
        "NEXT_PUBLIC_PLATFORM_URL",
        "NEXT_PUBLIC_ANALYTICS_ID",
        "NEXT_PUBLIC_GA_TRACKING_ID",
        "NEXT_PUBLIC_GA_MEASUREMENT_ID",
        "NEXT_PUBLIC_TBE_APP_ID",
        "VITE_TBE_APP_ID",
        "NEXT_PUBLIC_SENTRY_DSN",
        "NEXT_PUBLIC_ONBOARDING_APP_URL",
        "VITE_BASE_API_URL",
        "NEXT_PUBLIC_PREPYATRA_BASE_URL",
        "MONGO_URI",
        "SITE_URL"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env.production.local",
        ".env.local",
        ".env.production",
        ".env"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "build:cloud-run": {
      "cache": true,
      "dependsOn": ["^build"],
      "env": [
        "GOOGLE_AUTH_CLIENT_ID",
        "GOOGLE_AUTH_CLIENT_SECRET",
        "MONGODB_URI",
        "API_URL",
        "AUTH_JWT_SECRET",
        "ADMIN_SECRET",
        "NEXTAUTH_SECRET",
        "NEXTAUTH_URL",
        "ALLOWED_AUTH_ORIGINS",
        "NODE_ENV",
        "OPENAI_API_KEY",
        "YOUTUBE_API_KEY",
        "ADMIN_BASE_URL",
        "CASHFREE_BASE_URL",
        "CASHFREE_SECRET_KEY",
        "CASHFREE_CLIENT_ID",
        "NEXT_PUBLIC_CASHFREE_MODE",
        "PREPYATRA_APP_URL",
        "QUIZ_APP_URL",
        "EMAIL_API_KEY",
        "FROM_EMAIL",
        "EMAIL_SERVICE_URL",
        "SENTRY_AUTH_TOKEN",
        "ONBOARDING_APP_URL",
        "QUIZZES_APP_URL",
        "NEXT_PUBLIC_UNSKILLED_API_URL",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_ONBOARDING_URL",
        "NEXT_PUBLIC_PLATFORM_URL",
        "NEXT_PUBLIC_ANALYTICS_ID",
        "NEXT_PUBLIC_GA_TRACKING_ID",
        "NEXT_PUBLIC_GA_MEASUREMENT_ID",
        "NEXT_PUBLIC_TBE_APP_ID",
        "VITE_TBE_APP_ID",
        "NEXT_PUBLIC_SENTRY_DSN",
        "NEXT_PUBLIC_ONBOARDING_APP_URL",
        "VITE_BASE_API_URL",
        "NEXT_PUBLIC_PREPYATRA_BASE_URL",
        "MONGO_URI",
        "SITE_URL"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env.production.local",
        ".env.local",
        ".env.production",
        ".env"
      ],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "inputs": ["$TURBO_DEFAULT$", "eslint.config.js", ".eslintrc*"],
      "cache": true
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": false,
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env.development.local",
        ".env.local",
        ".env.development",
        ".env"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": ["coverage/**", "test-results/**"],
      "inputs": [
        "src/**/*.{ts,tsx}",
        "src/**/*.test.{ts,tsx}",
        "src/**/*.spec.{ts,tsx}",
        ".env.test"
      ]
    },
    "test:unit": {
      "cache": true,
      "outputs": ["coverage/**"],
      "inputs": ["src/unit/**/*.{ts,tsx}", "src/test-utils/**/*.{ts,tsx}"]
    },
    "test:api": {
      "cache": true,
      "outputs": ["coverage/**"],
      "inputs": ["src/api/**/*.{ts,tsx}", "src/test-utils/**/*.{ts,tsx}"]
    },
    "test:coverage": {
      "cache": true,
      "outputs": ["coverage/**"]
    },
    "test:ci": {
      "dependsOn": ["test:unit", "test:api"],
      "cache": false
    },
    "test:e2e": {
      "cache": false,
      "inputs": ["src/e2e/**/*.{ts,tsx}", "playwright.config.ts"]
    },
    "test:e2e:ui": {
      "cache": false,
      "persistent": true
    }
  }
}

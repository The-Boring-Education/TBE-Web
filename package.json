{
  "name": "tbe-platform",
  "private": true,
  "version": "2.9.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "clean": "turbo run clean",
    "dev:platform": "turbo run dev --filter=@tbe/platform",
    "dev:prep-yatra": "turbo run dev --filter=@tbe/prep-yatra",
    "dev:quizes": "turbo run dev --filter=@tbe/quizes",
    "dev:onboarding": "turbo run dev --filter=@tbe/onboarding",
    "dev:api": "turbo run dev --filter=@tbe/api",
    "dev:techyatra": "turbo run dev --filter=@tbe/techyatra",
    "dev:dsayatra": "turbo run dev --filter=@tbe/dsayatra",
    "dev:resume-yatra": "turbo run dev --filter=@tbe/resume-yatra",
    "dev:oncampus": "turbo run dev --filter=@tbe/oncampus",
    "build:platform": "turbo run build --filter=@tbe/platform",
    "build:prep-yatra": "turbo run build --filter=@tbe/prep-yatra",
    "build:quizes": "turbo run build --filter=@tbe/quizes",
    "build:onboarding": "turbo run build --filter=@tbe/onboarding",
    "build:api": "turbo run build --filter=@tbe/api",
    "build:techyatra": "turbo run build --filter=@tbe/techyatra",
    "build:dsayatra": "turbo run build --filter=@tbe/dsayatra",
    "build:resume-yatra": "turbo run build --filter=@tbe/resume-yatra",
    "build:oncampus": "turbo run build --filter=@tbe/oncampus",
    "install:all": "pnpm install",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit --filter=@tbe/testing",
    "test:unit:watch": "turbo run test:unit:watch --filter=@tbe/testing",
    "test:api": "turbo run test:api --filter=@tbe/testing",
    "test:e2e": "turbo run test:e2e --filter=@tbe/testing",
    "test:e2e:ui": "turbo run test:e2e:ui --filter=@tbe/testing",
    "test:coverage": "turbo run test:coverage --filter=@tbe/testing",
    "test:ci": "turbo run test:ci --filter=@tbe/testing",
    "seo:audit": "lhci autorun",
    "seo:audit:prod": "LHCI_ENV=production lhci autorun",
    "seo:audit:app": "LHCI_ENV=production lhci autorun"
  },
  "devDependencies": {
    "@lhci/cli": "^0.13.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/uuid": "^9.0.1",
    "baseline-browser-mapping": "^2.9.11",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.x",
    "pnpm": ">=9.12.0"
  },
  "pnpm": {
    "overrides": {
      "@opentelemetry/resources": "1.17.1",
      "@opentelemetry/sdk-trace-base": "1.17.1"
    }
  },
  "dependencies": {
    "@floating-ui/utils": "^0.2.10",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.1",
    "@radix-ui/react-aspect-ratio": "^1.1.0",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.3.0",
    "lucide-react": "^0.562.0",
    "react-day-picker": "^8.10.1",
    "react-markdown": "^10.1.0",
    "react-query": "3.39.3",
    "react-syntax-highlighter": "^15.6.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^1.5.0",
    "styled-jsx": "^5.1.7",
    "tailwind-merge": "^2.5.2",
    "vercel": "^48.1.4"
  }
}

# ===================================================================
# TBE Platform - Environment Variables Template
# Copy this file to .env.local for local development
# ===================================================================

# ========== DATABASE ==========
# MongoDB connection string - shared across all apps
MONGODB_URI=mongodb://localhost:27017/tbe-platform

# ========== AUTHENTICATION ==========
# NextAuth secret for JWT encryption - shared across all apps
NEXTAUTH_SECRET=your-nextauth-secret-here

# Google OAuth credentials - shared across all apps
GOOGLE_AUTH_CLIENT_ID=your-google-client-id
GOOGLE_AUTH_CLIENT_SECRET=your-google-client-secret

# ========== EXTERNAL APIs ==========
# OpenAI API key for AI features
OPENAI_API_KEY=your-openai-api-key

# YouTube API key for video features
YOUTUBE_API_KEY=your-youtube-api-key

# ========== PAYMENT GATEWAY ==========
# Cashfree payment gateway credentials
CASHFREE_BASE_URL=https://sandbox.cashfree.com/pg
CASHFREE_CLIENT_ID=your-cashfree-client-id
CASHFREE_SECRET_KEY=your-cashfree-secret-key

# ========== MONITORING & ANALYTICS ==========
# Google Analytics tracking ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=your-ga-tracking-id

# Sentry DSN for error tracking
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn

# ========== ADMIN ==========
# Admin panel secret key
ADMIN_SECRET=your-admin-secret

# Admin panel URL
ADMIN_BASE_URL=http://localhost:3000/admin

# ========== APP URLs (Development) ==========
# Base URLs for each app in development
NEXT_PUBLIC_WEBAPP_URL=http://localhost:3000
NEXT_PUBLIC_PREPYATRA_URL=http://localhost:3001
NEXT_PUBLIC_QUIZES_URL=http://localhost:3002
NEXT_PUBLIC_ONBOARDING_URL=http://localhost:3003

# Cross-app API URLs
NEXT_PUBLIC_TBE_WEBAPP_API_URL=http://localhost:3000/api/v1
BASE_API_URL=http://localhost:3000/api/v1
BASE_AUTH_API_URL=http://localhost:3000/api/auth

# ========== EMAIL SERVICE ==========
# Email service configuration
EMAIL_SERVICE_URL=https://chitthi.up.railway.app
EMAIL_API_KEY=your-email-api-key
FROM_EMAIL=noreply@theboringeducation.com

# ========== ENVIRONMENT ==========
NODE_ENV=development

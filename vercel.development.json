{
    "buildCommand": "npm run build",
    "functions": {
        "src/pages/api/**/*.ts": {
            "maxDuration": 30
        }
    },
    "rewrites": [
        {
            "source": "/prepyatra/:match*",
            "destination": "https://prep-yatra-git-development-tbe.vercel.app/:match*"
        },
        {
            "source": "/quizzes/:match*",
            "destination": "https://the-boring-quizes-git-development-tbe.vercel.app/:match*"
        }
    ],
    "headers": [
        {
            "source": "/fonts/inter-var-latin.woff2",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/prepyatra/(.*)",
            "headers": [
                {
                    "key": "X-Frame-Options",
                    "value": "SAMEORIGIN"
                },
                {
                    "key": "Cache-Control",
                    "value": "public, s-maxage=60, stale-while-revalidate=300"
                },
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                }
            ]
        },
        {
            "source": "/quizzes/(.*)",
            "headers": [
                {
                    "key": "X-Frame-Options",
                    "value": "SAMEORIGIN"
                },
                {
                    "key": "Cache-Control",
                    "value": "public, s-maxage=60, stale-while-revalidate=300"
                },
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                }
            ]
        }
    ]
}
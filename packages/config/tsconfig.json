{
  "extends": "@tbe/typescript-config/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "./",
    "declaration": true,
    "declarationMap": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": ["./*.ts"],
  "exclude": ["node_modules", "dist", "*.config.js"]
}
